# =============================================================================
# MS Photo Studio / MS Photo Studio — environment configuration
#
# Local:  cp .env.example .env
# Render: set these in Dashboard → your web service → Environment
# =============================================================================

# --- Core ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# --- Site ---
SITE_NAME=MS Photo Studio
SITE_DOMAIN=http://localhost:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ---
# Leave empty for SQLite (local default).
# DATABASE_URL=postgres://lumina:lumina@localhost:5432/lumina

# Docker Compose / Postgres (alternative to DATABASE_URL)
# USE_POSTGRES=True
# POSTGRES_DB=lumina
# POSTGRES_USER=lumina
# POSTGRES_PASSWORD=lumina
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Security (enable in production) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=2592000

# --- Render production example ---
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generate-a-strong-secret>
# SITE_DOMAIN=https://msphotostudio.onrender.com
# CSRF_TRUSTED_ORIGINS=https://msphotostudio.onrender.com
# DJANGO_ALLOWED_HOSTS=.onrender.com
# DATABASE_URL=<from Render Postgres dashboard>
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# --- S3 media storage (recommended on Render) ---
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=MS Photo Studio <studio@msphotostudio.com>
STUDIO_NOTIFICATION_EMAIL=studio@msphotostudio.com
NOTIFY_EMAILS_ENABLED=True

# --- Gallery ---
GALLERY_DEFAULT_EXPIRY_DAYS=90
GALLERY_MAX_BULK_UPLOAD=200
GALLERY_ZIP_MAX_IMAGES=300

# --- Locale ---
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
SESSION_COOKIE_AGE=43200

# --- Netlify (only if using Netlify + Render split deploy) ---
# NETLIFY=False
# DJANGO_BACKEND_URL=https://msphotostudio.onrender.com
